source "https://rubygems.org"

# Matches the versions GitHub Pages builds with, so local previews mirror
# production. Do not pin `jekyll` alongside this — github-pages resolves it.
gem "github-pages", group: :jekyll_plugins

# No longer bundled with Ruby 3.x; Jekyll's dev server needs it.
gem "webrick", "~> 1.8"

# Silences a Faraday v2 warning from github-pages-health-check.
gem "faraday-retry"

# Bundled-gem warnings on Ruby 3.4+
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
